<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Quiet palette: one muted surface, the potato is the only colourful thing.
         Sage is reserved for the main action and "on" states. -->
    <Color x:Key="SurfaceColor">#25232A</Color>
    <Color x:Key="RaisedColor">#302D36</Color>
    <Color x:Key="HairlineColor">#3B3743</Color>
    <Color x:Key="TextColor">#ECE8E1</Color>
    <Color x:Key="MutedColor">#9A94A3</Color>
    <Color x:Key="AccentColor">#A9C68E</Color>
    <Color x:Key="AccentHoverColor">#BBD4A3</Color>
    <Color x:Key="AccentInkColor">#1B2315</Color>

    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="RaisedBrush" Color="{StaticResource RaisedColor}"/>
    <SolidColorBrush x:Key="HairlineBrush" Color="{StaticResource HairlineColor}"/>
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}"/>
    <SolidColorBrush x:Key="AccentInkBrush" Color="{StaticResource AccentInkColor}"/>

    <!-- Segoe UI Variable on Windows; the bundled Inter everywhere else. -->
    <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI, fonts:Inter#Inter</FontFamily>
    <FontFamily x:Key="BodyFont">Segoe UI Variable Text, Segoe UI, fonts:Inter#Inter</FontFamily>

    <!-- Text -->
    <ControlTheme x:Key="Title" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    </ControlTheme>
    <ControlTheme x:Key="Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </ControlTheme>
    <ControlTheme x:Key="Muted" TargetType="TextBlock" BasedOn="{StaticResource Body}">
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
        <Setter Property="FontSize" Value="12.5"/>
    </ControlTheme>
    <ControlTheme x:Key="GroupLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
        <Setter Property="Margin" Value="0,22,0,6"/>
    </ControlTheme>

    <!-- Main action -->
    <ControlTheme x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Foreground" Value="{StaticResource AccentInkBrush}"/>
        <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="7"/>
        <Setter Property="Padding" Value="13,6"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Border#Bd">
            <Setter Property="Background" Value="{StaticResource AccentHoverBrush}"/>
        </Style>
        <Style Selector="^:pressed /template/ Border#Bd">
            <Setter Property="Opacity" Value="0.85"/>
        </Style>
        <Style Selector="^:focus-visible /template/ Border#Bd">
            <Setter Property="BorderBrush" Value="{StaticResource TextBrush}"/>
        </Style>
    </ControlTheme>

    <!-- Everything else: no border, a soft fill only on hover -->
    <ControlTheme x:Key="QuietButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>
        <Style Selector="^:pointerover /template/ Border#Bd">
            <Setter Property="Background" Value="{StaticResource RaisedBrush}"/>
        </Style>
        <Style Selector="^:pressed /template/ Border#Bd">
            <Setter Property="Background" Value="{StaticResource HairlineBrush}"/>
        </Style>
        <Style Selector="^:focus-visible /template/ Border#Bd">
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="FontSize" Value="14"/>
    </ControlTheme>

    <!-- Toggle switch -->
    <ControlTheme x:Key="ToggleSwitch" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,6"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Grid ColumnDefinitions="*,Auto" Background="{TemplateBinding Background}">
                    <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}"
                                      VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <Border Name="Track" Grid.Column="1" Width="36" Height="20" CornerRadius="10"
                            Background="{StaticResource RaisedBrush}" BorderBrush="Transparent" BorderThickness="1">
                        <Ellipse Name="Thumb" Width="12" Height="12" HorizontalAlignment="Left" Margin="3,0,0,0"
                                 Fill="{StaticResource MutedBrush}" RenderTransform="translateX(0px)">
                            <Ellipse.Transitions>
                                <Transitions>
                                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.14"/>
                                </Transitions>
                            </Ellipse.Transitions>
                        </Ellipse>
                    </Border>
                </Grid>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:checked /template/ Border#Track">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
        </Style>
        <Style Selector="^:checked /template/ Ellipse#Thumb">
            <Setter Property="Fill" Value="{StaticResource AccentInkBrush}"/>
            <Setter Property="RenderTransform" Value="translateX(16px)"/>
        </Style>
        <Style Selector="^:focus-visible /template/ Border#Track">
            <Setter Property="BorderBrush" Value="{StaticResource TextBrush}"/>
        </Style>
    </ControlTheme>
</ResourceDictionary>
