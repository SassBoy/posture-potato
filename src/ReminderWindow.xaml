<Window x:Class="PosturePotato.ReminderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PosturePotato"
        Title="Posture check" Width="460" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Grid x:Name="Root" Opacity="0">

        <!-- The card. Its bottom edge is the soil the potato pops out of. -->
        <Border x:Name="Card" Margin="58,48,10,12" CornerRadius="12"
                Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.28"/>
            </Border.Effect>
            <Border.RenderTransform>
                <TranslateTransform x:Name="CardShift"/>
            </Border.RenderTransform>
            <Grid>
                <StackPanel Margin="70,13,16,16">
                    <TextBlock x:Name="TitleText" Style="{StaticResource Title}" Text="Posture check"/>
                    <TextBlock x:Name="TipText" Style="{StaticResource Muted}" Margin="0,2,0,11"/>
                    <StackPanel x:Name="Actions" Orientation="Horizontal">
                        <Button Style="{StaticResource PrimaryButton}" Content="I'm sitting up" Click="Done_Click"/>
                    </StackPanel>
                </StackPanel>

                <!-- Time left before the check hides itself. Hover to hold it. -->
                <Border x:Name="CountdownTrack" VerticalAlignment="Bottom" Height="2" Margin="70,0,16,7" CornerRadius="1"
                        Background="{StaticResource RaisedBrush}">
                    <Border x:Name="Countdown" Background="{StaticResource AccentBrush}" Opacity="0.7" CornerRadius="1">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="CountdownScale"/>
                        </Border.RenderTransform>
                    </Border>
                </Border>
            </Grid>
        </Border>

        <!-- The potato, clipped at the card's bottom edge so it rises out of it -->
        <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Width="140" Height="160"
                Margin="0,0,0,12" ClipToBounds="True" IsHitTestVisible="False">
            <local:PotatoView x:Name="Potato" ArtScale="3" VerticalAlignment="Bottom" HorizontalAlignment="Center"/>
        </Border>
    </Grid>
</Window>
